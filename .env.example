# Required in production
DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"
STAFF_MASTER_CODE="replace-with-a-long-random-secret"

# Required only when Clerk auth is enabled
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""

# Optional frontend metadata
VITE_APP_URL="https://your-production-domain.example"
VITE_BRAND_NAME="Crede-Ti"
BASE_PATH="/"

# Optional services/features
BLOB_READ_WRITE_TOKEN=""
RESEND_API_KEY=""
RESEND_FROM="Crede-Ti <noreply@your-domain.com>"
LOG_LEVEL="info"
DEMO_MODE_ENABLED="false"
