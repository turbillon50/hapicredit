# Required in production
DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"
STAFF_MASTER_CODE="replace-with-a-long-random-secret"
SUPERADMIN_CODE="replace-with-superadmin-secret"  # Separate code for Luis superadmin access

# Required only when Clerk auth is enabled
# Vercel currently uses NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY; the Vite build also
# accepts VITE_CLERK_PUBLISHABLE_KEY for local development.
VITE_CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Optional frontend metadata
# Vercel currently uses NEXT_PUBLIC_APP_URL / NEXT_PUBLIC_BRAND_NAME; the Vite
# build also accepts the VITE_* names below.
VITE_APP_URL="https://your-production-domain.example"
NEXT_PUBLIC_APP_URL="https://your-production-domain.example"
VITE_BRAND_NAME="Crede-Ti"
NEXT_PUBLIC_BRAND_NAME="Crede-Ti"
BASE_PATH="/"

# Optional services/features
BLOB_READ_WRITE_TOKEN=""
RESEND_API_KEY=""
RESEND_FROM="Crede-Ti <noreply@your-domain.com>"
LOG_LEVEL="info"
DEMO_MODE_ENABLED="false"
